<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#FF2B2B2B" BorderBrush="#FF1C1C1C" BorderThickness="1" CornerRadius="4" Padding="16,10,16,10" Margin="0,0,0,4">
<Grid>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
    <TextBlock FontSize="17" TextTrimming="CharacterEllipsis" MaxLines="1">$LABEL$</TextBlock>
    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap">$NOTE$</TextBlock>
  </StackPanel>
  $CONTROL$
</Grid>
</Border>
