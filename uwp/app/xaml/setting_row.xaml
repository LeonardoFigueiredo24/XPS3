<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D9171D32" BorderBrush="#44394671" BorderThickness="1" CornerRadius="10" Padding="20,14" Margin="0,0,0,8">
<Grid>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#FFF4F6FF" TextTrimming="CharacterEllipsis" MaxLines="1">$LABEL$</TextBlock>
    <TextBlock FontSize="12" Foreground="#FF9BA7CA" TextWrapping="Wrap" Margin="0,4,0,0">$NOTE$</TextBlock>
  </StackPanel>
  $CONTROL$
</Grid>
</Border>
