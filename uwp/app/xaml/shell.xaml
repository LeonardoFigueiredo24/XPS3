<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" Background="#FF080B16" RequestedTheme="Dark">

  <!-- XPS3 Cell Horizon: an original, television-first visual language. All content in the
       library and settings is supplied by the real emulator model; no sample games or fake
       capabilities are represented here. -->

  <!-- Game picture: the emulator's frames are presented into this panel's swap chain. -->
  <SwapChainPanel x:Name="GamePanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

  <!-- The app menu, shown whenever no game runs. -->
  <Grid x:Name="MenuLayer">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF080B16" Offset="0"/>
        <GradientStop Color="#FF101936" Offset="0.58"/>
        <GradientStop Color="#FF17102D" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <Grid IsHitTestVisible="False" Opacity="0.34">
      <Ellipse Width="700" Height="700" Margin="0,-410,-250,0" HorizontalAlignment="Right" VerticalAlignment="Top"
               Stroke="#FF42D7FF" StrokeThickness="2"/>
      <Ellipse Width="510" Height="510" Margin="0,-310,-155,0" HorizontalAlignment="Right" VerticalAlignment="Top"
               Stroke="#FF7A5CFF" StrokeThickness="1"/>
      <Rectangle Width="930" Height="1" Margin="0,0,-290,200" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Fill="#FF245CFF" RenderTransformOrigin="0.5,0.5">
        <Rectangle.RenderTransform><RotateTransform Angle="-13"/></Rectangle.RenderTransform>
      </Rectangle>
    </Grid>
    <Grid Margin="64,36,64,34">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="21" BorderBrush="#FF42D7FF" BorderThickness="2" Margin="0,0,14,0">
            <Grid>
              <Ellipse Width="12" Height="12" Fill="#FF7A5CFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,7,0,0"/>
              <Ellipse Width="9" Height="9" Fill="#FF42D7FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
              <TextBlock Text="3" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <StackPanel>
            <TextBlock FontSize="30" FontWeight="SemiBold" CharacterSpacing="90">XPS3</TextBlock>
            <TextBlock FontSize="11" Foreground="#FF9BA7CA" CharacterSpacing="160">CELL HORIZON</TextBlock>
          </StackPanel>
          <Border Background="#33245CFF" BorderBrush="#66245CFF" BorderThickness="1" CornerRadius="12" Padding="9,3"
                  Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF9EC5FF">EXPERIMENTAL</TextBlock>
          </Border>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="TelemetryIdText" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <StackPanel x:Name="UsbHint" Orientation="Horizontal" Margin="0,0,22,0" Visibility="Collapsed" VerticalAlignment="Center">
              <ProgressRing IsActive="True" Width="16" Height="16" Foreground="#FFFFB45C" Margin="0,0,8,0"/>
              <TextBlock FontSize="13" Foreground="#FFFFB45C" VerticalAlignment="Center">Lendo armazenamento USB...</TextBlock>
            </StackPanel>
            <StackPanel Margin="0,0,22,0">
              <TextBlock Text="BUILD" FontSize="10" Foreground="#FF7782A6" CharacterSpacing="120"/>
              <TextBlock x:Name="VersionText" FontSize="13" Foreground="#FFDDE5FF"/>
              <TextBlock x:Name="UpdateText" FontSize="11" Foreground="#FFFFB45C" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="FIRMWARE" FontSize="10" Foreground="#FF7782A6" CharacterSpacing="120"/>
              <TextBlock x:Name="FirmwareText" FontSize="13" Foreground="#FFDDE5FF"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>

      <Pivot x:Name="MenuPivot" Grid.Row="1" IsHeaderItemsCarouselEnabled="False" Margin="0,22,0,0">
        <Pivot.HeaderTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontSize="19" FontWeight="SemiBold" CharacterSpacing="20"/>
          </DataTemplate>
        </Pivot.HeaderTemplate>

        <PivotItem Header="Biblioteca" Margin="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="190"/>
            </Grid.RowDefinitions>

            <Border x:Name="DetailsPanel" Grid.Row="0" Margin="0,8,0,14" CornerRadius="22" BorderBrush="#44245CFF"
                    BorderThickness="1" Visibility="Collapsed" MinHeight="250">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#F2182143" Offset="0"/>
                  <GradientStop Color="#E91B2A5C" Offset="0.58"/>
                  <GradientStop Color="#E72D1550" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid Padding="42,34">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*"/>
                  <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1" IsHitTestVisible="False" Opacity="0.65">
                  <Ellipse Width="310" Height="310" Stroke="#FF42D7FF" StrokeThickness="2" HorizontalAlignment="Right"/>
                  <Ellipse Width="220" Height="220" Stroke="#FF7A5CFF" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,0,45,0"/>
                  <Rectangle Width="360" Height="2" Fill="#FF245CFF" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="-22"/></Rectangle.RenderTransform>
                  </Rectangle>
                </Grid>
                <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                  <TextBlock Text="SELECIONADO" FontSize="11" FontWeight="SemiBold" Foreground="#FF42D7FF" CharacterSpacing="150"/>
                  <TextBlock x:Name="DetailTitle" FontSize="46" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" Margin="0,8,0,17"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DetailId" FontSize="13" Foreground="#FFDDE5FF" Margin="0,0,18,0"/>
                    <TextBlock x:Name="DetailKind" FontSize="13" Foreground="#FF9BA7CA" Margin="0,0,18,0"/>
                    <TextBlock x:Name="DetailVersion" FontSize="13" Foreground="#FF9BA7CA"/>
                  </StackPanel>
                  <TextBlock x:Name="DetailSource" FontSize="11" Foreground="#FF7782A6" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                  <Border Background="#FFF4F6FF" CornerRadius="22" Padding="24,11" Margin="0,24,0,0" HorizontalAlignment="Left">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#FF080B16">Ⓐ  Iniciar jogo</TextBlock>
                  </Border>
                </StackPanel>
                <Border Grid.Column="1" Width="300" Height="180" CornerRadius="12" Background="#88080B16"
                        BorderBrush="#553FD9FF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Grid>
                    <Image x:Name="DetailIcon" Stretch="Uniform" Margin="14"/>
                    <TextBlock x:Name="DetailPlaceholder" FontSize="48" Foreground="#FF42D7FF" Opacity="0.6"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <StackPanel x:Name="GamesBusy" Grid.RowSpan="3" Orientation="Horizontal" Margin="0,30,0,0" VerticalAlignment="Top">
              <ProgressRing IsActive="True" Width="28" Height="28" Foreground="#FF42D7FF" Margin="0,0,14,0"/>
              <TextBlock FontSize="15" Foreground="#FF9BA7CA" VerticalAlignment="Center">Procurando jogos...</TextBlock>
            </StackPanel>
            <TextBlock x:Name="GamesEmpty" Grid.RowSpan="3" Margin="0,30,0,0" FontSize="15" Foreground="#FF9BA7CA"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <Grid Grid.Row="1" Margin="0,0,0,10">
              <TextBlock Text="Seus jogos" FontSize="24" FontWeight="SemiBold"/>
              <TextBlock Text="USB + armazenamento local" FontSize="12" Foreground="#FF7782A6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ListView x:Name="GamesList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True"
                      SingleSelectionFollowsFocus="True" ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled">
              <ListView.ItemsPanel>
                <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ListView.ItemsPanel>
            </ListView>
          </Grid>
        </PivotItem>

        <PivotItem Header="Instalar" Margin="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#B3171D32" BorderBrush="#44245CFF" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,8,0,14">
              <TextBlock FontSize="14" Foreground="#FFB9C3E2" TextWrapping="Wrap">Firmware legítimo (PS3UPDAT.PUP), pacotes (.pkg) e licenças (.rap) encontrados no armazenamento local ou em uma unidade USB autorizada.</TextBlock>
            </Border>
            <StackPanel x:Name="InstallBusy" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top">
              <ProgressRing IsActive="True" Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <TextBlock FontSize="15" Foreground="#FF9BA7CA" VerticalAlignment="Center">Procurando arquivos...</TextBlock>
            </StackPanel>
            <TextBlock x:Name="InstallEmpty" Grid.Row="1" FontSize="15" Foreground="#FFFFB45C" Visibility="Collapsed"/>
            <ListView x:Name="InstallList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True"
                      SingleSelectionFollowsFocus="True"/>
          </Grid>
        </PivotItem>

        <PivotItem Header="Configurações" Margin="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,8,12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,8,38,0">
                <TextBlock Text="Configurações" FontSize="28" FontWeight="SemiBold"/>
                <Border Height="2" Background="#FF42D7FF" Margin="0,18,90,18"/>
                <TextBlock Text="Ajustes disponíveis" FontSize="17" FontWeight="SemiBold" Foreground="#FFDDE5FF"/>
                <TextBlock Text="Alterações ligadas ao núcleo integrado. Use o controle para selecionar e alterar cada opção." FontSize="14" Foreground="#FF9BA7CA" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel>
              <StackPanel x:Name="SettingsStack" Grid.Column="1"/>
            </Grid>
          </ScrollViewer>
        </PivotItem>
      </Pivot>

      <Grid Grid.Row="2" Margin="0,8,0,0">
        <TextBlock x:Name="StatusText" FontSize="12" Foreground="#FF9BA7CA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <Border Background="#C4080B16" BorderBrush="#33245CFF" BorderThickness="1" CornerRadius="9" Padding="15,8"
                HorizontalAlignment="Right">
          <TextBlock FontSize="13" Foreground="#FFDDE5FF"><Run Foreground="#FF8BE85D">Ⓐ</Run> Selecionar   <Run Foreground="#FFFFB45C">Ⓨ</Run> Atualizar   LB/RB Abas   View+Menu Pausa</TextBlock>
        </Border>
      </Grid>
    </Grid>
  </Grid>

  <!-- A screen of the menu logic: a list of actions under a status text (Settings > RPCN account). -->
  <Grid x:Name="ScreenLayer" Visibility="Collapsed">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF080B16" Offset="0"/>
        <GradientStop Color="#FF101936" Offset="0.65"/>
        <GradientStop Color="#FF17102D" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <Grid Margin="48,27,48,27">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="ScreenTitle" Grid.Row="0" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock x:Name="ScreenHeader" Grid.Row="1" FontSize="15" Opacity="0.75" TextWrapping="Wrap" Margin="0,12,0,16" MaxWidth="1100" HorizontalAlignment="Left"/>
      <ScrollViewer x:Name="ScreenScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ScreenItems" MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,12,0"/>
      </ScrollViewer>
      <Border Grid.Row="3" Background="#C4080B16" BorderBrush="#33245CFF" BorderThickness="1" CornerRadius="9"
              Padding="15,8" Margin="0,6,0,0" HorizontalAlignment="Right">
        <TextBlock FontSize="13"><Run Foreground="#FF8BE85D">Ⓐ</Run> Selecionar   <Run Foreground="#FFFF5F67">Ⓑ</Run> Voltar</TextBlock>
      </Border>
    </Grid>
  </Grid>

  <!-- A text field the menu logic asks for (RPCN account details). A on the field opens the system keyboard. -->
  <Grid x:Name="TextLayer" Visibility="Collapsed">
    <Rectangle Fill="#99000000"/>
    <Border Background="#FF171D32" BorderBrush="#663FD9FF" BorderThickness="1" CornerRadius="14"
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="620">
      <StackPanel>
        <StackPanel Padding="24,24,24,8">
          <TextBlock x:Name="TextTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="TextPrompt" FontSize="15" Opacity="0.75" TextWrapping="Wrap" Margin="0,10,0,14"/>
          <StackPanel x:Name="TextFieldHost"/>
          <TextBlock x:Name="TextError" FontSize="14" Foreground="#FFFF99A4" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
          <TextBlock FontSize="13" Opacity="0.6" Margin="0,10,0,8" TextWrapping="Wrap">A on the field opens the keyboard. B cancels.</TextBlock>
        </StackPanel>
        <Grid Background="#FF10162A" Padding="24" CornerRadius="0,0,14,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="TextOk" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,4,0" Content="Done"/>
          <Button x:Name="TextCancel" Grid.Column="1" HorizontalAlignment="Stretch" Margin="4,0,0,0" Content="Cancel"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>

  <!-- Boot / compile progress, over a dark backdrop (over the game picture while it compiles). -->
  <Grid x:Name="LoadingLayer" Visibility="Collapsed">
    <Rectangle x:Name="LoadingBackdrop" Fill="#FF080B16"/>
    <StackPanel VerticalAlignment="Center" Margin="48,0,48,0">
      <TextBlock x:Name="LoadingTitle" FontSize="22" FontWeight="SemiBold"/>
      <ProgressBar x:Name="LoadingBar" Maximum="100" Margin="0,18,0,18"/>
      <TextBlock x:Name="LoadingDetail" FontSize="14" Opacity="0.7" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>

  <!-- Firmware / package install progress. -->
  <Grid x:Name="JobLayer" Visibility="Collapsed">
    <Rectangle Fill="#99000000"/>
    <Border Background="#FF171D32" BorderBrush="#663FD9FF" BorderThickness="1" CornerRadius="14"
            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Width="560">
      <StackPanel>
        <TextBlock x:Name="JobTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <ProgressBar x:Name="JobBar" Maximum="100" Margin="0,18,0,12"/>
        <TextBlock x:Name="JobDetail" FontSize="14" Opacity="0.7"/>
      </StackPanel>
    </Border>
  </Grid>

  <!-- In-game pause menu (hold View + Menu). -->
  <Grid x:Name="PauseLayer" Visibility="Collapsed">
    <Rectangle Fill="#99000000"/>
    <Border Background="#F2171D32" BorderBrush="#663FD9FF" BorderThickness="1" CornerRadius="22"
            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,40,64,40" Padding="30" Width="560">
      <ScrollViewer x:Name="PauseScroll" MaxHeight="610" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF42D7FF" CharacterSpacing="150">EMULAÇÃO</TextBlock>
          <TextBlock FontSize="30" FontWeight="SemiBold" Margin="0,5,0,24">Menu rápido</TextBlock>
          <Button x:Name="PauseResume" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Continuar jogo" Margin="0,0,0,8"/>
          <Button x:Name="PauseStop" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Encerrar e voltar à biblioteca" Margin="0,0,0,16"/>
          <TextBlock FontSize="14" Foreground="#FF9BA7CA" TextWrapping="Wrap" Margin="0,0,0,6">Somente ajustes com aplicação imediata aparecem aqui. Os demais entram em vigor na próxima inicialização.</TextBlock>
          <StackPanel x:Name="PauseSettingsStack"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

  <!-- Message / confirmation. Declared after the pause menu so it draws on top of it
       (e.g. the "Stop the game?" confirmation opened from the pause menu). -->
  <Grid x:Name="DialogLayer" Visibility="Collapsed">
    <Rectangle Fill="#99000000"/>
    <Border Background="#FF171D32" BorderBrush="#663FD9FF" BorderThickness="1" CornerRadius="14"
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="620">
      <StackPanel>
        <StackPanel Padding="24,24,24,16">
          <TextBlock x:Name="DialogTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <ScrollViewer MaxHeight="330" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="DialogText" FontSize="15" Opacity="0.75" TextWrapping="Wrap"/>
          </ScrollViewer>
        </StackPanel>
        <Grid Background="#FF10162A" Padding="24" CornerRadius="0,0,14,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="DialogAccept" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
          <Button x:Name="DialogCancel" Grid.Column="1" HorizontalAlignment="Stretch" Margin="4,0,0,0" Content="Cancel"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>

  <!-- Fatal emulator error. -->
  <Grid x:Name="ErrorLayer" Visibility="Collapsed" Background="#FF080B16">
    <Border Background="#FF351D2C" BorderBrush="#FFFF5F67" BorderThickness="1" CornerRadius="14" Padding="24"
            VerticalAlignment="Center" Margin="48,0,48,0">
    <StackPanel>
      <TextBlock FontSize="22" FontWeight="SemiBold">Emulation error</TextBlock>
      <TextBlock x:Name="ErrorText" FontSize="15" Margin="0,16,0,16" TextWrapping="Wrap"/>
      <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap">The full log is LocalState/rpcs3/RPCS3.log (RPCS3.prev.log after the app restarts).</TextBlock>
    </StackPanel>
    </Border>
  </Grid>
</Grid>
