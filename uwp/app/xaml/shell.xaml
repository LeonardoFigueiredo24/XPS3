<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" Background="#FF15161B" RequestedTheme="Dark">

  <!-- Game picture: the emulator's frames are presented into this panel's swap chain. -->
  <SwapChainPanel x:Name="GamePanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

  <!-- The app menu, shown whenever no game runs. -->
  <Grid x:Name="MenuLayer" Background="#FF15161B">
    <Grid Margin="48,27,48,27">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
          <TextBlock FontSize="26" FontWeight="SemiBold">RPCS3</TextBlock>
          <TextBlock FontSize="15" Opacity="0.6" Margin="12,0,0,4" VerticalAlignment="Bottom">for Xbox  (unofficial test build)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <TextBlock x:Name="UsbHint" FontSize="14" Foreground="#FFE8B04D" Margin="0,0,24,3" Visibility="Collapsed">Reading USB drives...</TextBlock>
          <TextBlock x:Name="FirmwareText" FontSize="14" Margin="0,0,0,3"/>
        </StackPanel>
      </Grid>

      <Pivot x:Name="MenuPivot" Grid.Row="1" IsHeaderItemsCarouselEnabled="False">
        <Pivot.HeaderTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontSize="20"/>
          </DataTemplate>
        </Pivot.HeaderTemplate>

        <PivotItem Header="Games" Margin="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="GamesList" SelectionMode="Single" IsItemClickEnabled="True"
                      SingleSelectionFollowsFocus="True" Margin="0,8,12,0"/>
            <TextBlock x:Name="GamesEmpty" Grid.ColumnSpan="2" Margin="0,16,0,0" FontSize="15" Opacity="0.7"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <Border x:Name="DetailsPanel" Grid.Column="1" Background="#FF1B1D24" Padding="16"
                    Margin="0,8,0,0" VerticalAlignment="Top" Visibility="Collapsed">
              <StackPanel>
                <Grid Background="#FF101116" Height="140">
                  <Image x:Name="DetailIcon" Stretch="Uniform"/>
                  <TextBlock x:Name="DetailPlaceholder" FontSize="36" Opacity="0.5" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="DetailTitle" FontSize="17" TextWrapping="Wrap" MaxLines="2" Margin="0,12,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" FontSize="12" Opacity="0.6" Margin="0,0,0,4">Title ID</TextBlock>
                  <TextBlock x:Name="DetailId" Grid.Row="0" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="1" FontSize="12" Opacity="0.6" Margin="0,0,0,4">Type</TextBlock>
                  <TextBlock x:Name="DetailKind" Grid.Row="1" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="2" FontSize="12" Opacity="0.6" Margin="0,0,0,4">Version</TextBlock>
                  <TextBlock x:Name="DetailVersion" Grid.Row="2" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="3" FontSize="12" Opacity="0.6" Margin="0,0,0,4">Location</TextBlock>
                  <TextBlock x:Name="DetailSource" Grid.Row="3" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <TextBlock FontSize="15" Foreground="#FF4D8FE8" Margin="0,10,0,0">A  Start</TextBlock>
              </StackPanel>
            </Border>
          </Grid>
        </PivotItem>

        <PivotItem Header="Install" Margin="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Margin="0,8,0,8" FontSize="14" Opacity="0.7" TextWrapping="Wrap">Firmware (PS3UPDAT.PUP), packages (.pkg) and licenses (.rap) from the app's LocalState, LocalState\firmware or LocalState\packages folder, or from a USB drive (root, PS3\UPDATE, PKG, packages or exdata folder).</TextBlock>
            <TextBlock x:Name="InstallEmpty" Grid.Row="1" FontSize="15" Foreground="#FFE8B04D" Visibility="Collapsed"/>
            <ListView x:Name="InstallList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True"
                      SingleSelectionFollowsFocus="True"/>
          </Grid>
        </PivotItem>

        <PivotItem Header="Settings" Margin="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsStack" Margin="0,8,12,0"/>
          </ScrollViewer>
        </PivotItem>
      </Pivot>

      <StackPanel Grid.Row="2" Margin="0,6,0,0">
        <TextBlock x:Name="StatusText" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
        <TextBlock FontSize="13" Opacity="0.55">A  Select      Y  Refresh      LB / RB  Tabs      In a game: hold View + Menu for the pause menu</TextBlock>
      </StackPanel>
    </Grid>
  </Grid>

  <!-- Boot / compile progress, over a dark backdrop (over the game picture while it compiles). -->
  <Grid x:Name="LoadingLayer" Visibility="Collapsed">
    <Rectangle x:Name="LoadingBackdrop" Fill="#FF15161B"/>
    <StackPanel VerticalAlignment="Center" Margin="48,0,48,0">
      <TextBlock x:Name="LoadingTitle" FontSize="22"/>
      <ProgressBar x:Name="LoadingBar" Maximum="100" Margin="0,18,0,18"/>
      <TextBlock x:Name="LoadingDetail" FontSize="14" Opacity="0.7" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>

  <!-- Firmware / package install progress. -->
  <Grid x:Name="JobLayer" Visibility="Collapsed">
    <Rectangle Fill="#C0000000"/>
    <Border Background="#FF1B1D24" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Width="560">
      <StackPanel>
        <TextBlock x:Name="JobTitle" FontSize="20" TextWrapping="Wrap"/>
        <ProgressBar x:Name="JobBar" Maximum="100" Margin="0,18,0,12"/>
        <TextBlock x:Name="JobDetail" FontSize="14" Opacity="0.7"/>
      </StackPanel>
    </Border>
  </Grid>

  <!-- Message / confirmation. -->
  <Grid x:Name="DialogLayer" Visibility="Collapsed">
    <Rectangle Fill="#C0000000"/>
    <Border Background="#FF1B1D24" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Width="620">
      <StackPanel>
        <TextBlock x:Name="DialogTitle" FontSize="20" TextWrapping="Wrap"/>
        <ScrollViewer MaxHeight="240" Margin="0,14,0,18" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="DialogText" FontSize="15" Opacity="0.75" TextWrapping="Wrap"/>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="DialogAccept" MinWidth="130" Margin="0,0,12,0"/>
          <Button x:Name="DialogCancel" MinWidth="130" Content="Cancel"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>

  <!-- In-game pause menu (hold View + Menu). -->
  <Grid x:Name="PauseLayer" Visibility="Collapsed">
    <Rectangle Fill="#C0000000"/>
    <Border Background="#FF1B1D24" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Width="560">
      <ScrollViewer x:Name="PauseScroll" MaxHeight="460" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock FontSize="22" Margin="0,0,0,14">Paused</TextBlock>
          <Button x:Name="PauseResume" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Resume game" Margin="0,0,0,8"/>
          <Button x:Name="PauseStop" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Stop game and return to the menu" Margin="0,0,0,16"/>
          <TextBlock FontSize="14" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,6">Settings that apply right away. The others take effect the next time a game starts; change them in the app menu.</TextBlock>
          <StackPanel x:Name="PauseSettingsStack"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

  <!-- Fatal emulator error. -->
  <Grid x:Name="ErrorLayer" Visibility="Collapsed" Background="#FF3A1414">
    <StackPanel VerticalAlignment="Center" Margin="48,0,48,0">
      <TextBlock FontSize="22">Emulation error</TextBlock>
      <TextBlock x:Name="ErrorText" FontSize="15" Margin="0,16,0,16" TextWrapping="Wrap"/>
      <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap">The full log is LocalState/rpcs3/RPCS3.log (RPCS3.prev.log after the app restarts).</TextBlock>
    </StackPanel>
  </Grid>
</Grid>
