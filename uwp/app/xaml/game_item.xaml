<ListViewItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              Width="224" Height="194" HorizontalContentAlignment="Stretch" Padding="7" Margin="0,0,8,0">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="112"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Background="#CC10162A" BorderBrush="#44245CFF" BorderThickness="1" CornerRadius="10">
      <Grid>
        <Image x:Name="Icon" Stretch="Uniform" Margin="8"/>
        <TextBlock x:Name="Placeholder" FontSize="25" Foreground="#FF42D7FF" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center">$PLACEHOLDER$</TextBlock>
      </Grid>
    </Border>
    <StackPanel Grid.Row="1" Margin="3,9,3,0">
      <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2">$TITLE$</TextBlock>
      <TextBlock FontSize="11" Foreground="#FF8591B4" TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,3,0,0">$SUBTITLE$</TextBlock>
    </StackPanel>
  </Grid>
</ListViewItem>
