+static void
+dzn_pso_log_details(struct dzn_physical_device *pdev, const uintptr_t *src_buf, size_t size)
+{
+   mesa_loge("dzn:   options2 depth bounds %d, options3 view instancing tier %d",
+             (int)pdev->options2.DepthBoundsTestSupported, (int)pdev->options3.ViewInstancingTier);
+   const uint8_t *p = (const uint8_t *)src_buf, *end = p + size;
+   while (p < end) {
+      D3D12_PIPELINE_STATE_SUBOBJECT_TYPE t = *(const D3D12_PIPELINE_STATE_SUBOBJECT_TYPE *)p;
+      size_t off = 0, sz = dzn_pso_subobject_size(t, &off);
+      if (!sz)
+         return;
+      const void *d = p + off;
+      switch (t) {
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_FLAGS:
+         mesa_loge("dzn:   flags 0x%x", *(const unsigned *)d);
+         break;
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PRIMITIVE_TOPOLOGY:
+         mesa_loge("dzn:   topology type %u", *(const unsigned *)d);
+         break;
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_SAMPLE_DESC: {
+         const DXGI_SAMPLE_DESC *sdsc = d;
+         mesa_loge("dzn:   sample count %u quality %u", sdsc->Count, sdsc->Quality);
+         break;
+      }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL_FORMAT:
+         mesa_loge("dzn:   depth format %u", *(const unsigned *)d);
+         break;
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RENDER_TARGET_FORMATS: {
+         const struct D3D12_RT_FORMAT_ARRAY *rt = d;
+         mesa_loge("dzn:   %u render targets, formats %u %u %u %u", rt->NumRenderTargets,
+                   rt->RTFormats[0], rt->RTFormats[1], rt->RTFormats[2], rt->RTFormats[3]);
+         break;
+      }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_BLEND: {
+         const D3D12_BLEND_DESC *b = d;
+         mesa_loge("dzn:   blend a2c %d independent %d, rt0 blend %d logic %d (op %d) src %d dst %d op %d "
+                   "srcA %d dstA %d opA %d mask 0x%x",
+                   b->AlphaToCoverageEnable, b->IndependentBlendEnable, b->RenderTarget[0].BlendEnable,
+                   b->RenderTarget[0].LogicOpEnable, b->RenderTarget[0].LogicOp, b->RenderTarget[0].SrcBlend,
+                   b->RenderTarget[0].DestBlend, b->RenderTarget[0].BlendOp, b->RenderTarget[0].SrcBlendAlpha,
+                   b->RenderTarget[0].DestBlendAlpha, b->RenderTarget[0].BlendOpAlpha,
+                   b->RenderTarget[0].RenderTargetWriteMask);
+         break;
+      }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER: {
+         const D3D12_RASTERIZER_DESC *r = d;
+         mesa_loge("dzn:   rast fill %d cull %d ccw %d bias %d clamp %f slope %f clip %d ms %d aa %d forced %u cons %d",
+                   r->FillMode, r->CullMode, r->FrontCounterClockwise, r->DepthBias, r->DepthBiasClamp,
+                   r->SlopeScaledDepthBias, r->DepthClipEnable, r->MultisampleEnable,
+                   r->AntialiasedLineEnable, r->ForcedSampleCount, r->ConservativeRaster);
+         break;
+      }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL1: {
+         const D3D12_DEPTH_STENCIL_DESC1 *z = d;
+         mesa_loge("dzn:   ds1 depth %d write %d func %d stencil %d rmask 0x%x wmask 0x%x bounds %d",
+                   z->DepthEnable, z->DepthWriteMask, z->DepthFunc, z->StencilEnable,
+                   z->StencilReadMask, z->StencilWriteMask, z->DepthBoundsTestEnable);
+         break;
+      }
+      default:
+         break;
+      }
+      p += ALIGN_POT(sz, sizeof(void *));
+   }
+}
+
+static void
+dzn_pso_rebuild_probe(struct dzn_device *device, struct dzn_physical_device *pdev,
+                      const uintptr_t *src_buf, size_t size)
+{
+#define T(x) (1ull << D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_##x)
+   static const struct { const char *what; uint64_t drop; bool ds1_to_ds; } tries[] = {
+      { "depth-stencil1 as plain depth-stencil", 0, true },
+      { "no flags", T(FLAGS), false },
+      { "no sample desc", T(SAMPLE_DESC), false },
+      { "no blend", T(BLEND), false },
+      { "no rasterizer", T(RASTERIZER) | T(RASTERIZER1) | T(RASTERIZER2), false },
+      { "no depth-stencil state or format", T(DEPTH_STENCIL1) | T(DEPTH_STENCIL2) | T(DEPTH_STENCIL_FORMAT), false },
+      { "plain ds, no flags/sample/blend", T(FLAGS) | T(SAMPLE_DESC) | T(BLEND), true },
+      { "only root signature, VS, topology",
+        T(FLAGS) | T(SAMPLE_DESC) | T(BLEND) | T(RASTERIZER) | T(RASTERIZER1) | T(RASTERIZER2) |
+        T(DEPTH_STENCIL1) | T(DEPTH_STENCIL2) | T(DEPTH_STENCIL_FORMAT) | T(RENDER_TARGET_FORMATS) |
+        T(PS) | T(INPUT_LAYOUT) | T(IB_STRIP_CUT_VALUE), false },
+      { "only root signature, VS, PS, topology, RT formats",
+        T(FLAGS) | T(SAMPLE_DESC) | T(BLEND) | T(RASTERIZER) | T(RASTERIZER1) | T(RASTERIZER2) |
+        T(DEPTH_STENCIL1) | T(DEPTH_STENCIL2) | T(DEPTH_STENCIL_FORMAT) | T(INPUT_LAYOUT) |
+        T(IB_STRIP_CUT_VALUE), false },
+   };
+#undef T
+   dzn_pso_log_details(pdev, src_buf, size);
+   for (unsigned i = 0; i < ARRAY_SIZE(tries); i++) {
+      HRESULT hr = dzn_pso_rebuild_try(device, src_buf, size, tries[i].drop, tries[i].ds1_to_ds);
+      mesa_loge("dzn:   retry with %s: 0x%08x", tries[i].what, (unsigned)hr);
+   }
+}
+
+/* Xbox UWP diagnostics: there is no D3D12 debug layer on the console, so when a graphics PSO
+ * fails, retry with one setting changed at a time and log which change makes it valid. */
+static void
+dzn_log_dxil_version(const char *stage, const D3D12_SHADER_BYTECODE *bc)
+{
+   if (!bc || !bc->pShaderBytecode || bc->BytecodeLength < 32) {
+      mesa_loge("dzn:   %s: none", stage);
+      return;
+   }
+   const uint8_t *b = bc->pShaderBytecode;
+   for (size_t i = 0; i + 12 < bc->BytecodeLength; i += 4) {
+      if (!memcmp(b + i, "DXIL", 4)) {
+         uint32_t ver;
+         memcpy(&ver, b + i + 8, 4);
+         mesa_loge("dzn:   %s: %zu bytes, shader model %u.%u (kind %u)", stage, (size_t)bc->BytecodeLength,
+                   (ver >> 4) & 0xf, ver & 0xf, ver >> 16);
+         return;
+      }
+   }
+   mesa_loge("dzn:   %s: %zu bytes, no DXIL part", stage, (size_t)bc->BytecodeLength);
+}
+
+static void
+dzn_pso_failure_probe(struct dzn_device *device, struct dzn_physical_device *pdev,
+                      struct dzn_graphics_pipeline *pipeline, const uintptr_t *src_buf, size_t size)
+{
+   static const char *const stage_names[] = { "VS", "HS", "DS", "GS", "PS" };
+   mesa_loge("dzn:   options14 independent stencil masks %d, options16 dynamic depth bias %d, "
+             "options19 narrow quad lines %d, offsets cut %u rast %u ds %u, stream %zu bytes",
+             (int)pdev->options14.IndependentFrontAndBackStencilRefMaskSupported,
+             (int)pdev->options16.DynamicDepthBiasSupported,
+             (int)pdev->options19.NarrowQuadrilateralLinesSupported,
+             pipeline->templates.desc_offsets.ib_strip_cut, pipeline->templates.desc_offsets.rast,
+             pipeline->templates.desc_offsets.ds, size);
+   {
+      /* Walk the stream and list subobject types. */
+      const uint8_t *p = (const uint8_t *)src_buf, *end = p + size;
+      char types[256]; int n = 0;
+      types[0] = 0;
+      while (p < end && n < (int)sizeof(types) - 8) {
+         D3D12_PIPELINE_STATE_SUBOBJECT_TYPE t = *(const D3D12_PIPELINE_STATE_SUBOBJECT_TYPE *)p;
+         n += snprintf(types + n, sizeof(types) - n, "%d ", (int)t);
+         size_t sz = dzn_pso_subobject_size(t, NULL);
+         if (!sz) break;
+         p += ALIGN_POT(sz, sizeof(void *));
+      }
+      mesa_loge("dzn:   subobject types: %s", types);
+   }
+   for (unsigned st = 0; st < ARRAY_SIZE(stage_names); st++) {
+      const D3D12_SHADER_BYTECODE *bc = pipeline->templates.shaders[st].bc;
+      if (bc)
+         dzn_log_dxil_version(stage_names[st], bc);
+   }
+
+   dzn_pso_rebuild_probe(device, pdev, src_buf, size);
+
+   for (unsigned m = 0; m < 7; m++) {
+      uintptr_t buf[MAX_GFX_PIPELINE_STATE_STREAM_SIZE / sizeof(uintptr_t)];
+      memcpy(buf, src_buf, size);
+      const char *what = NULL;
+
+      D3D12_INDEX_BUFFER_STRIP_CUT_VALUE *cut = dzn_graphics_pipeline_get_desc(pipeline, buf, ib_strip_cut);
+      D3D12_RASTERIZER_DESC *rast = dzn_graphics_pipeline_get_desc(pipeline, buf, rast);
+      void *ds = dzn_graphics_pipeline_get_desc(pipeline, buf, ds);
+      bool ds2 = pdev->options14.IndependentFrontAndBackStencilRefMaskSupported;
+      bool rast2 = pdev->options19.NarrowQuadrilateralLinesSupported;
+
+      switch (m) {
+      case 0:
+         if (cut) { *cut = D3D12_INDEX_BUFFER_STRIP_CUT_VALUE_DISABLED; what = "strip cut disabled"; }
+         break;
+      case 1:
+         if (rast && rast2) {
+            D3D12_RASTERIZER_DESC2 *r2 = (D3D12_RASTERIZER_DESC2 *)rast;
+            r2->DepthBias = 0; r2->SlopeScaledDepthBias = 0; r2->DepthBiasClamp = 0;
+            r2->ConservativeRaster = D3D12_CONSERVATIVE_RASTERIZATION_MODE_OFF;
+            r2->ForcedSampleCount = 0;
+            r2->LineRasterizationMode = D3D12_LINE_RASTERIZATION_MODE_ALIASED;
+            what = "rasterizer2 bias/conservative/forced samples cleared, aliased lines";
+         } else if (rast) {
+            rast->DepthBias = 0; rast->SlopeScaledDepthBias = 0; rast->DepthBiasClamp = 0;
+            rast->ConservativeRaster = D3D12_CONSERVATIVE_RASTERIZATION_MODE_OFF;
+            rast->ForcedSampleCount = 0;
+            rast->MultisampleEnable = FALSE; rast->AntialiasedLineEnable = FALSE;
+            what = "rasterizer bias/conservative/forced samples/line AA cleared";
+         }
+         break;
+      case 2:
+         if (rast) { rast->FillMode = D3D12_FILL_MODE_SOLID; rast->CullMode = D3D12_CULL_MODE_NONE; rast->DepthClipEnable = TRUE; what = "rasterizer solid/no cull/depth clip"; }
+         break;
+      case 3:
+         if (ds) {
+            if (ds2) ((D3D12_DEPTH_STENCIL_DESC2 *)ds)->DepthBoundsTestEnable = FALSE;
+            else ((D3D12_DEPTH_STENCIL_DESC1 *)ds)->DepthBoundsTestEnable = FALSE;
+            what = "depth bounds test off";
+         }
+         break;
+      case 4:
+         if (ds) {
+            if (ds2) { ((D3D12_DEPTH_STENCIL_DESC2 *)ds)->StencilEnable = FALSE; ((D3D12_DEPTH_STENCIL_DESC2 *)ds)->DepthEnable = FALSE; }
+            else { ((D3D12_DEPTH_STENCIL_DESC1 *)ds)->StencilEnable = FALSE; ((D3D12_DEPTH_STENCIL_DESC1 *)ds)->DepthEnable = FALSE; }
+            what = "depth and stencil off";
+         }
+         break;
+      case 5:
+      case 6: {
+         /* Drop the pixel shader (5) or the geometry shader (6). */
+         const D3D12_SHADER_BYTECODE *bc = pipeline->templates.shaders[m == 5 ? MESA_SHADER_FRAGMENT : MESA_SHADER_GEOMETRY].bc;
+         if (bc) {
+            D3D12_SHADER_BYTECODE *copy = (D3D12_SHADER_BYTECODE *)((uint8_t *)buf + ((const uint8_t *)bc - (const uint8_t *)pipeline->templates.stream_buf));
+            copy->pShaderBytecode = NULL;
+            copy->BytecodeLength = 0;
+            what = m == 5 ? "no pixel shader" : "no geometry shader";
+         }
+         break;
+      }
+      }
+      if (!what)
+         continue;
+
+      D3D12_PIPELINE_STATE_STREAM_DESC desc = { .SizeInBytes = size, .pPipelineStateSubobjectStream = buf };
+      ID3D12PipelineState *state = NULL;
+      HRESULT hr = ID3D12Device4_CreatePipelineState(device->dev, &desc, &IID_ID3D12PipelineState, (void **)&state);
+      mesa_loge("dzn:   retry with %s: 0x%08x", what, (unsigned)hr);
+      if (state)
+         ID3D12PipelineState_Release(state);
+   }
+}
