+/* Print what the D3D12 debug layer recorded (only available when it is enabled, DZN_DEBUG=d3d12). */
+static void
+dzn_log_d3d12_messages(struct dzn_device *device)
+{
+   ID3D12InfoQueue *info_queue;
+   if (FAILED(ID3D12Device1_QueryInterface(device->dev, &IID_ID3D12InfoQueue, (void **)&info_queue))) {
+      mesa_loge("dzn: no D3D12 info queue (debug layer not available)");
+      return;
+   }
+
+   UINT64 count = ID3D12InfoQueue_GetNumStoredMessages(info_queue);
+   for (UINT64 i = 0; i < count; i++) {
+      SIZE_T size = 0;
+      if (FAILED(ID3D12InfoQueue_GetMessage(info_queue, i, NULL, &size)) || !size)
+         continue;
+      D3D12_MESSAGE *msg = malloc(size);
+      if (msg && SUCCEEDED(ID3D12InfoQueue_GetMessage(info_queue, i, msg, &size)))
+         mesa_loge("dzn: D3D12 [%d/%d] %s", (int)msg->Severity, (int)msg->ID, msg->pDescription);
+      free(msg);
+   }
+   ID3D12InfoQueue_ClearStoredMessages(info_queue);
+   ID3D12InfoQueue_Release(info_queue);
+}
+
 VKAPI_ATTR VkResult VKAPI_CALL
 dzn_EndCommandBuffer(VkCommandBuffer commandBuffer)
 {
@@ -1078,8 +1102,11 @@ dzn_EndCommandBuffer(VkCommandBuffer commandBuffer)
       dzn_cmd_buffer_gather_events(cmdbuf);
       dzn_cmd_buffer_gather_queries(cmdbuf);
       HRESULT hres = ID3D12GraphicsCommandList1_Close(cmdbuf->cmdlist);
-      if (FAILED(hres))
+      if (FAILED(hres)) {
+         mesa_loge("dzn: ID3D12GraphicsCommandList::Close failed: 0x%08x", (unsigned)hres);
+         dzn_log_d3d12_messages(container_of(cmdbuf->vk.base.device, struct dzn_device, vk));
          vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+      }
    }
 
    return vk_command_buffer_end(&cmdbuf->vk);
