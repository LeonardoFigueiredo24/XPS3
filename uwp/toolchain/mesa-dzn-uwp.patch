+/* Rebuild a PSO stream with some subobjects dropped or converted, to find which one a driver rejects. */
+#define DZN_REBUILD_DS1_TO_DS (1u << 31)
+static HRESULT
+dzn_pso_rebuild_try(struct dzn_device *device, const uintptr_t *src_buf, size_t size,
+                    uint64_t drop_mask, bool ds1_to_ds)
+{
+   uintptr_t out[MAX_GFX_PIPELINE_STATE_STREAM_SIZE / sizeof(uintptr_t) + 8];
+   size_t out_size = 0;
+   const uint8_t *p = (const uint8_t *)src_buf, *end = p + size;
+   while (p < end) {
+      D3D12_PIPELINE_STATE_SUBOBJECT_TYPE t = *(const D3D12_PIPELINE_STATE_SUBOBJECT_TYPE *)p;
+      size_t off = 0, sz = dzn_pso_subobject_size(t, &off);
+      if (!sz)
+         return E_FAIL;
+      const uint8_t *desc = p + off;
+      size_t desc_size = sz - off;
+      p += ALIGN_POT(sz, sizeof(void *));
+      if (drop_mask & (1ull << t))
+         continue;
+      D3D12_PIPELINE_STATE_SUBOBJECT_TYPE nt = t;
+      if (ds1_to_ds && t == D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL1)
+         nt = D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL;
+      size_t noff = 0, nsz = dzn_pso_subobject_size(nt, &noff);
+      out_size = ALIGN_POT(out_size, sizeof(void *));
+      if (out_size + nsz > sizeof(out))
+         return E_FAIL;
+      uint8_t *dst = (uint8_t *)out + out_size;
+      memset(dst, 0, nsz);
+      *(D3D12_PIPELINE_STATE_SUBOBJECT_TYPE *)dst = nt;
+      memcpy(dst + noff, desc, MIN2(desc_size, nsz - noff));
+      out_size += nsz;
+   }
+   D3D12_PIPELINE_STATE_STREAM_DESC sd = { .SizeInBytes = out_size, .pPipelineStateSubobjectStream = out };
+   ID3D12PipelineState *state = NULL;
+   HRESULT hr = ID3D12Device4_CreatePipelineState(device->dev, &sd, &IID_ID3D12PipelineState, (void **)&state);
+   if (state)
+      ID3D12PipelineState_Release(state);
+   return hr;
+}
