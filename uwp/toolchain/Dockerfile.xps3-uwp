FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        bison \
        build-essential \
        ca-certificates \
        clang \
        curl \
        file \
        flex \
        git \
        libssl-dev \
        libtool \
        lld \
        llvm \
        nasm \
        osslsigncode \
        pkg-config \
        python3 \
        python3-pip \
        python3-venv \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/xps3-tools \
    && /opt/xps3-tools/bin/pip install --no-cache-dir \
        cmake \
        meson \
        ninja \
        ziglang

ENV PATH=/opt/xps3-tools/bin:${PATH}
ENV XPS3_JOBS=1

WORKDIR /src
CMD ["bash"]
