diff --git a/src/microsoft/vulkan/dzn_image.c b/src/microsoft/vulkan/dzn_image.c
index b67d131..72f81c5 100644
--- a/src/microsoft/vulkan/dzn_image.c
+++ b/src/microsoft/vulkan/dzn_image.c
@@ -260,6 +260,19 @@ dzn_image_create(struct dzn_device *device,
       }
    }
 
+   /* A depth image that is also sampled or copied gets its color format (R16_UNORM, R32_FLOAT)
+    * above, yet still ALLOW_DEPTH_STENCIL (from DEPTH_STENCIL_ATTACHMENT, or from TRANSFER_DST
+    * for clears). D3D12 accepts that only through a castable-format list
+    * (GetResourceAllocationInfo3/CreateCommittedResource3); without one (Xbox: FL 11_0, no
+    * relaxed casting) the description is invalid and the memory requirements come back empty.
+    * Use the typeless family instead, which every view format can be cast from. */
+   if (vk_format_is_depth_or_stencil(pCreateInfo->format) &&
+       image->vk.tiling == VK_IMAGE_TILING_OPTIMAL &&
+       (image->desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL) &&
+       (image->desc.Format == DXGI_FORMAT_R16_UNORM || image->desc.Format == DXGI_FORMAT_R32_FLOAT) &&
+       !(device->dev10 && device->dev12 && image->castable_format_count > 0))
+      image->desc.Format = dzn_get_typeless_dxgi_format(image->desc.Format);
+
    if (pCreateInfo->sharingMode == VK_SHARING_MODE_CONCURRENT &&
        !(image->desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL) &&
        image->desc.SampleDesc.Count == 1)
