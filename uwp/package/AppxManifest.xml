<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <!-- Publisher must match the XPS3 development certificate used at package time. -->
  <Identity Name="XPS3.Experimental.Emulator" Publisher="CN=XPS3Development" Version="0.3.1.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>XPS3 Experimental</DisplayName>
    <PublisherDisplayName>XPS3 development project</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
    <!-- WinUI 2 (Windows 11 control styles for the XAML menu). Install Microsoft.UI.Xaml.2.8.appx (x64, from the
         Microsoft.UI.Xaml 2.8.7 NuGet package, tools/AppX/x64/Release) as a dependency the first time. -->
    <PackageDependency Name="Microsoft.UI.Xaml.2.8" MinVersion="8.2501.31001.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="xps3_uwp.exe" EntryPoint="XPS3.App">
      <uap:VisualElements DisplayName="XPS3 Experimental" Description="Experimental PS3 emulator for Xbox Developer Mode; RPCS3-derived"
                          BackgroundColor="#1A1A1F" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
    <Application Id="ImportCheck" Executable="xps3_uwp_importcheck.exe" EntryPoint="XPS3.ImportCheck">
      <uap:VisualElements DisplayName="XPS3 import check" Description="Lists the system functions the emulator needs that this device is missing"
                          BackgroundColor="#1A1A1F" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="codeGeneration" />
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="broadFileSystemAccess" />
    <uap:Capability Name="removableStorage" />
  </Capabilities>
</Package>
